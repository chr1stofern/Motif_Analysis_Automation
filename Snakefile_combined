import sys; sys.path.append('/home/kwonschul/notebooks')
import os, time
import pandas as pd

# 
#
configfile: "config.yaml"

RAW_DATA_DIR = config.get("input_dir", "input_dir")
INTERMEDIATE_DIR = config.get("intermediate_dir", "intermediate_files")
PPSEQ_DIR = os.path.join(INTERMEDIATE_DIR, config.get("preprocessed-seq_dir", "preprocessed_sequences"))
os.makedirs(INTERMEDIATE_DIR, exist_ok=True)
os.makedirs(PPSEQ_DIR,        exist_ok=True)

LANE = "L2"
READ = 1

meta = pd.read_csv(config.get("sample_sheet", "samples.csv")).set_index("sample")

#CLEAVAGE   = [s for s in meta.index if meta.loc[s, "class"] == "cleavage"]
#DICTIONARY = [s for s in meta.index if meta.loc[s, "class"] == "dictionary"]

CLEAVAGE = meta.index[meta["class"] == "cleavage"].tolist()
DICTIONARY = meta.index[meta["class"] == "dictionary"].tolist()
SAMPLES = CLEAVAGE + DICTIONARY

MIN_QUAL = 30
MIN_QUALIFIED = 90

# write a log for each run
os.makedirs('logs', exist_ok=True)
DATE = time.strftime('%y%m%d')
LOG = 'logs/%s.log' % DATE
logf = open(LOG, 'a')
STAMP = '========== NEW RUN at %s ==========\n' % time.time()
logf.write(STAMP)
logf.close()

rule all:
	input: 'logs/%s.log' % DATE,
#			expand('qualitycheck/{sample}_L2_1.fastqc.zip', sample=SAMPLES),
            expand(f'{PPSEQ_DIR}/{{sample}}.collapsed.tsv', sample=SAMPLES),

rule make_log:
    output: 'logs/%s.log' % DATE
    shell: 'echo "{STAMP}" > {output}'

#rule fastqc:
#    output: 'qualitycheck/{sample}_L2_1.fastqc.zip'
#    threads: 32
#    shell: 'fastqc -o qualitycheck -t {threads} {RAW_DATA_DIR}/{wildcards.sample}_L2_1.fq.gz'

rule trim_adaptor:
    output: f'{PPSEQ_DIR}/{{sample}}.trim.fastq.gz'
    params:
        adapter_5p = lambda w: meta.loc[w.sample, "adapter_5p"],
        adapter_3p = lambda w: meta.loc[w.sample, "adapter_3p"],
    shell: 'cutadapt {RAW_DATA_DIR}/{wildcards.sample}_{LANE}_{READ}.fq.gz \
            --cores 30 -g {params.adapter_5p}...{params.adapter_3p} --trimmed-only 2>> {LOG} | \
			gzip -c - > {output}'

rule trim_random_adaptor_sequences:
    input:  f'{PPSEQ_DIR}/{{sample}}.trim.fastq.gz'
    output: f'{PPSEQ_DIR}/{{sample}}.trim.trim3part.fastq.gz'
    params:
        random_at_3p = lambda w: meta.loc[w.sample, "random_at_3p"],
        min_len      = lambda w: meta.loc[w.sample, "min_len"],
        max_len      = lambda w: meta.loc[w.sample, "max_len"],
    shell: 'cutadapt {input} -u {params.random_at_3p} -m {params.min_len} -M {params.max_len} --cores 30 2>> {LOG} | \
			gzip -c - > {output}'

rule quality_filter:
    input:  f'{PPSEQ_DIR}/{{sample}}.trim.trim3part.fastq.gz'
    output: f'{PPSEQ_DIR}/{{sample}}.trim.qc.fastq.gz'
    shell: 'zcat {input} | \
            fastq_quality_filter - -v -Q33 -q {MIN_QUAL} -p {MIN_QUALIFIED} 2>> {LOG} | \
            gzip -c - > {output}'

rule collapsing:
    input:  f'{PPSEQ_DIR}/{{sample}}.trim.qc.fastq.gz'
    output: f'{PPSEQ_DIR}/{{sample}}.collapsed.fa.gz'
    shell: 'zcat {input} | \
			fastx_collapser - -Q33 2>> {LOG} | \
			gzip -c - > {output}'

rule convert_to_tsv:
    input:  f'{PPSEQ_DIR}/{{sample}}.collapsed.fa.gz'
    output: f'{PPSEQ_DIR}/{{sample}}.collapsed.tsv'
    shell: 'zcat {input} | \
			seqkit fx2tab 2>> {LOG} > {output}'